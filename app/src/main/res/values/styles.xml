<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="primary">#17634E</color>
    <color name="primary_dark">#123F34</color>
    <color name="ink">#162D27</color>
    <color name="muted">#48635A</color>
    <color name="warning">#A52719</color>
    <color name="warning_bg">#FCE9E5</color>
    <color name="surface">#F2F6F4</color>
    <color name="paper">#FFFFFF</color>
    <color name="field">#F7FAF8</color>
    <color name="mint">#E1F1E8</color>
    <color name="line">#CEDFD6</color>

    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:navigationBarColor">@color/primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="KhoTitle" parent="android:style/Widget.Material.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="KhoBody" parent="android:style/Widget.Material.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="KhoLabel" parent="KhoBody">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="KhoSection" parent="KhoBody">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="KhoField" parent="android:style/Widget.Material.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:background">@drawable/kho_input</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:textSize">16sp</item>
        <item name="android:layout_marginBottom">14dp</item>
    </style>

    <style name="KhoButton" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@drawable/kho_primary</item>
        <item name="android:textColor">@color/paper</item>
    </style>

    <style name="KhoButtonSecondary" parent="KhoButton">
        <item name="android:background">@drawable/kho_secondary</item>
        <item name="android:textColor">@color/primary_dark</item>
    </style>

    <style name="KhoButtonDelete" parent="KhoButton">
        <item name="android:background">@drawable/kho_delete</item>
        <item name="android:textColor">@color/warning</item>
    </style>

    <style name="KhoWarning" parent="KhoBody">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/warning</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:background">@drawable/kho_warning</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:visibility">gone</item>
        <item name="android:layout_marginTop">7dp</item>
    </style>

    <string-array name="categories">
        <item>Điện tử</item>
        <item>Thực phẩm</item>
        <item>Văn phòng phẩm</item>
        <item>Gia dụng</item>
        <item>Khác</item>
    </string-array>
</resources>