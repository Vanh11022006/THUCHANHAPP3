<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:focusableInTouchMode="true">

        <TextView
            style="@style/KhoTitle"
            android:text="@string/add_product_label"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/kho_card"
            android:padding="18dp">

            <TextView
                style="@style/KhoLabel"
                android:text="@string/product_name_label"
                android:labelFor="@id/name" />

            <EditText
                android:id="@+id/name"
                style="@style/KhoField"
                android:hint="@string/product_name_hint"
                android:inputType="textCapSentences"
                android:singleLine="true" />

            <TextView
                style="@style/KhoLabel"
                android:text="@string/price_label"
                android:labelFor="@id/price" />

            <EditText
                android:id="@+id/price"
                style="@style/KhoField"
                android:hint="@string/price_hint"
                android:inputType="number" />

            <TextView
                style="@style/KhoLabel"
                android:text="@string/quantity_label"
                android:labelFor="@id/quantity" />

            <EditText
                android:id="@+id/quantity"
                style="@style/KhoField"
                android:hint="@string/quantity_hint"
                android:inputType="number" />

            <TextView
                style="@style/KhoLabel"
                android:text="@string/category_label"
                android:labelFor="@id/category" />

            <Spinner
                android:id="@+id/category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:prompt="@string/category_prompt"
                android:layout_marginBottom="12dp" />

            <Switch
                android:id="@+id/active"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:checked="true"
                android:layout_marginBottom="14dp"
                android:textSize="15sp"
                android:text="@string/active_label" />

            <TextView
                style="@style/KhoLabel"
                android:text="@string/description_label"
                android:labelFor="@id/description" />

            <EditText
                android:id="@+id/description"
                style="@style/KhoField"
                android:hint="@string/description_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3"
                android:gravity="top|start" />

            <Button
                android:id="@+id/save_product"
                style="@style/KhoButton"
                android:text="@string/save_label" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>